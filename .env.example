# Base de données PostgreSQL (Neon, Supabase, Vercel Postgres, Railway...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relayo"

# Secret pour signer les sessions (chaîne aléatoire longue)
AUTH_SECRET="change-moi-par-une-longue-chaine-aleatoire"

# URL publique de l'app (sert pour l'OAuth Instagram et l'URL du webhook)
APP_URL="http://localhost:3000"

# --- Instagram (API Instagram avec connexion Instagram) ---
# Laisse vide pour rester en mode démo.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Jeton choisi librement, à recopier dans la config webhook de l'app Meta
META_VERIFY_TOKEN="relayo-verify"

# Protège l'endpoint /api/cron (envoyé par Vercel Cron en Bearer)
CRON_SECRET="change-moi"
